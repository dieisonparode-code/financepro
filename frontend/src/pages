function Categorias({ lancamentos = [] }) {

  const dados = {};

  lancamentos
    .filter((item) => item.tipo === "despesa")
    .forEach((item) => {

      const categoria =
        item.categoria || "Outros";

      dados[categoria] =
        (dados[categoria] || 0) +
        Number(item.valor || 0);

    });


  return (

    <section className="panel">

      <h2>
        Despesas por categoria
      </h2>


      {Object.entries(dados).map(
        ([nome, valor]) => (

          <div
            className="transaction-item"
            key={nome}
          >

            <span>
              {nome}
            </span>

            <strong>
              R$ {valor.toFixed(2)}
            </strong>

          </div>

        )
      )}


    </section>

  );

}


export default Categorias;