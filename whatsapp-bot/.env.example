# Copia esse arquivo pra ".env" e preenche os valores.

# URL do backend do FinancePro em produção
BACKEND_URL=https://financepro-1-em2u.onrender.com

# O mesmo valor de WHATSAPP_BOT_TOKEN configurado no backend (Render)
WHATSAPP_BOT_TOKEN=

# ID da loja no FinancePro (número) — de qual loja essas fotos são
LOJA_ID=

# ID do grupo do WhatsApp (deixa em branco na primeira vez — o robô vai
# listar os grupos disponíveis no terminal pra você copiar o certo)
GRUPO_ID=
